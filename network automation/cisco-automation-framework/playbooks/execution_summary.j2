<!DOCTYPE html>
<html>
<head>
    <title>Ansible Execution Summary</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; }
        .header { background-color: #003366; color: white; padding: 20px; }
        .section { margin: 20px 0; padding: 15px; border: 1px solid #ddd; }
        .success { color: green; }
        .failed { color: red; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: 10px; text-align: left; border: 1px solid #ddd; }
        th { background-color: #f0f0f0; }
    </style>
</head>
<body>
    <div class="header">
        <h1>Ansible Playbook Execution Summary</h1>
        <p>Execution Date: {{ ansible_date_time.iso8601 }}</p>
    </div>

    <div class="section">
        <h2>Execution Details</h2>
        <p><strong>Total Duration:</strong> {{ ansible_runtime }}</p>
        <p><strong>Overall Status:</strong> <span class="success">SUCCESS</span></p>
    </div>

    <div class="section">
        <h2>Hosts Summary</h2>
        <table>
            <tr>
                <th>Hostname</th>
                <th>Role</th>
                <th>Status</th>
            </tr>
            {% for host in play_hosts %}
            <tr>
                <td>{{ host }}</td>
                <td>{{ hostvars[host].device_role | default('Unknown') }}</td>
                <td><span class="success">Configured</span></td>
            </tr>
            {% endfor %}
        </table>
    </div>

    <div class="section">
        <h2>Playbook Execution Log</h2>
        <p>Refer to logs/ansible.log for detailed execution logs</p>
    </div>

    <div class="section">
        <h2>Configuration Status</h2>
        <ul>
            <li>Day 0 Provisioning: COMPLETED</li>
            <li>Day 1 Deployment: COMPLETED</li>
            <li>Day 2 Validation: COMPLETED</li>
        </ul>
    </div>
</body>
</html>