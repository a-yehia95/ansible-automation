! ==============================================================================
! Keepalived Configuration for Kubernetes HA
! ==============================================================================

global_defs {
   notification_email {
   }
   notification_email_from keepalived@k8s.local
   smtp_server 127.0.0.1
   smtp_connect_timeout 30
   router_id k8s_vrrp
   script_user root
   enable_script_security
}

# Script to monitor HAProxy
vrrp_script check_apiserver {
    script "/etc/keepalived/check_apiserver.sh"
    interval 3
    weight -20
    fall 5
}

# Virtual IP configuration
vrrp_instance VI_1 {
    state {{ keepalived_state if inventory_hostname == 'master01' else 'BACKUP' }}
    interface {{ vip_interface }}
    virtual_router_id {{ keepalived_virtual_router_id }}
    priority {{ keepalived_priority if inventory_hostname == 'master01' else (keepalived_priority - 10) }}
    advert_int 1
    authentication {
        auth_type {{ keepalived_auth_type }}
        auth_pass {{ keepalived_auth_pass }}
    }
    virtual_ipaddress {
        {{ control_plane_vip }}/{{ vip_subnet_mask }} dev {{ vip_interface }} label {{ vip_interface }}:vip
    }
    track_script {
        check_apiserver
    }
    notify_master "/etc/keepalived/notify_master.sh"
    notify_backup "/etc/keepalived/notify_backup.sh"
    notify_fault "/etc/keepalived/notify_fault.sh"
}
