# ETCD Configuration Environment File
# This file contains environment variables for etcd configuration

ETCD_NAME={{ etcd_name }}
ETCD_DATA_DIR=/var/lib/etcd
ETCD_LISTEN_CLIENT_URLS={{ etcd_listen_client_urls }}
ETCD_ADVERTISE_CLIENT_URLS={{ etcd_advertise_client_urls }}
ETCD_LISTEN_PEER_URLS={{ etcd_listen_peer_urls }}
ETCD_INITIAL_ADVERTISE_PEER_URLS={{ etcd_initial_advertise_peer_urls }}
ETCD_INITIAL_CLUSTER="{{ etcd_initial_cluster }}"
ETCD_INITIAL_CLUSTER_STATE={{ etcd_initial_cluster_state }}
ETCD_INITIAL_CLUSTER_TOKEN=etcd-cluster
ETCD_CERT_FILE={{ etcd_cert_path }}/server.pem
ETCD_KEY_FILE={{ etcd_cert_path }}/server-key.pem
ETCD_CLIENT_CERT_AUTH=true
ETCD_TRUSTED_CA_FILE={{ etcd_cert_path }}/ca.pem
ETCD_PEER_CERT_FILE={{ etcd_cert_path }}/peer.pem
ETCD_PEER_KEY_FILE={{ etcd_cert_path }}/peer-key.pem
ETCD_PEER_CLIENT_CERT_AUTH=true
ETCD_PEER_TRUSTED_CA_FILE={{ etcd_cert_path }}/ca.pem
