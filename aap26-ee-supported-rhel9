ARG EE_BASE_IMAGE="quay.io/redhat-user-workloads/ansible-tenant/ansible-automation-platform-26/ee-minimal-rhel9@sha256:105ad5c7c5f7b5c4c5ac5478fcdf5de4b5b66d91bb15fa0bc926a4b7da329847"
ARG PYCMD="/usr/bin/python3.12"
ARG PKGMGR_PRESERVE_CACHE=""
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS=""
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS=""
ARG PKGMGR="/usr/bin/microdnf"

Base build stage
FROM $EE_BASE_IMAGE AS base
USER root
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ARG EE_BASE_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS
ARG PKGMGR

COPY _build/scripts/ /output/scripts/
COPY _build/scripts/entrypoint /opt/builder/bin/entrypoint

# Galaxy build stage
FROM base AS galaxy
ARG EE_BASE_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS
ARG PKGMGR

RUN /output/scripts/check_galaxy
COPY _build /build
WORKDIR /build

RUN mkdir -p /usr/share/ansible
RUN ansible-galaxy role install $ANSIBLE_GALAXY_CLI_ROLE_OPTS -r requirements.yml --roles-path "/usr/share/ansible/roles"
RUN ANSIBLE_GALAXY_DISABLE_GPG_VERIFY=1 ansible-galaxy collection install $ANSIBLE_GALAXY_CLI_COLLECTION_OPTS -r requirements.yml --collections-path "/usr/share/ansible/collections"
RUN ANSIBLE_GALAXY_DISABLE_GPG_VERIFY=1 ansible-galaxy collection install $ANSIBLE_GALAXY_CLI_COLLECTION_OPTS -r controller-requirements-2.6.yml --collections-path "/usr/share/automation-controller/collections"

# Builder build stage
FROM base AS builder
ENV PIP_BREAK_SYSTEM_PACKAGES=1
WORKDIR /build
ARG EE_BASE_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS
ARG PKGMGR

RUN $PYCMD -m pip install --no-cache-dir bindep pyyaml packaging
ENV PIP_OPTS="--use-pep517 --disable-pip-version-check"
ENV GRPC_PYTHON_BUILD_WITH_CYTHON=False \
GRPC_PYTHON_BUILD_SYSTEM_OPENSSL=1 \
GRPC_PYTHON_BUILD_SYSTEM_ZLIB=1 \
GRPC_PYTHON_BUILD_SYSTEM_CARES=True \
GRPC_PYTHON_LDFLAGS="-Wl,--strip-debug"
RUN if [ "$(uname -m)" == "aarch64" ]; then export GRPC_PYTHON_BUILD_EXT_COMPILER_JOBS=9; fi
RUN if [ "$(uname -m)" == "s390x" ]; then export GRPC_PYTHON_BUILD_EXT_COMPILER_JOBS=16; fi
RUN if [ "$(uname -m)" == "ppc64le" ]; then export GRPC_PYTHON_BUILD_EXT_COMPILER_JOBS=33; fi
ENV SUDS_PACKAGE=suds
COPY --from=galaxy /usr/share/automation-controller/collections /usr/share/ansible/collections

COPY --from=galaxy /usr/share/ansible /usr/share/ansible

COPY _build/requirements.txt requirements.txt
COPY _build/exclude-requirements.txt exclude-requirements.txt
COPY _build/bindep.txt bindep.txt
COPY _build/exclude-bindep.txt exclude-bindep.txt
COPY _build/exclude-collections.txt exclude-collections.txt
RUN $PYCMD /output/scripts/introspect.py introspect --user-pip=requirements.txt --exclude-pip-reqs=exclude-requirements.txt --user-bindep=bindep.txt --exclude-bindep-reqs=exclude-bindep.txt --exclude-collection-reqs=exclude-collections.txt --write-bindep=/tmp/src/bindep.txt --write-pip=/tmp/src/requirements.txt
RUN /output/scripts/assemble
RUN $PYCMD -m pip install $PIP_OPTS --cache-dir=/output/wheels file:///cachi2/output/deps/generic/vsphere-automation-sdk-python.tar.gz

# Final build stage
FROM base AS final
ENV PIP_BREAK_SYSTEM_PACKAGES=1
ARG EE_BASE_IMAGE
ARG PYCMD
ARG PKGMGR_PRESERVE_CACHE
ARG ANSIBLE_GALAXY_CLI_COLLECTION_OPTS
ARG ANSIBLE_GALAXY_CLI_ROLE_OPTS
ARG PKGMGR


COPY --from=galaxy /usr/share/ansible /usr/share/ansible

COPY --from=builder /output/ /output/
RUN /output/scripts/install-from-bindep && rm -rf /output/wheels
RUN mkdir -p /runner && chgrp 0 /runner && chmod -R ug+rwx /runner
WORKDIR /runner
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1
RUN alternatives --install /usr/bin/pip3 pip3 /usr/bin/pip3.12 1
RUN $PYCMD -m pip install $PIP_OPTS --cache-dir=/output/wheels file:///cachi2/output/deps/generic/vsphere-automation-sdk-python.tar.gz
RUN rm -rf /home/runner/.cache
COPY --from=galaxy /usr/share/automation-controller /usr/share/automation-controller
ENV DESCRIPTION="Red Hat Ansible Automation Platform Supported Execution Environment" \
    container=oci
LABEL com.redhat.component="ee-supported-container" \
    name="ansible-automation-platform-26/ee-supported-rhel9" \
    cpe="cpe:/a:redhat:ansible_automation_platform:2.6::el9" \
    version="2.0.0" \
    summary="$DESCRIPTION" \
    io.openshift.expose-services="" \
    io.openshift.tags="execution-environment,automation,ansible" \
    io.k8s.display-name="ee-supported-rhel9" \
    maintainer="Ansible Automation Platform Productization Team" \
    description="$DESCRIPTION" \
    io.k8s.description="$DESCRIPTION"
RUN rm -rf /output
LABEL ansible-execution-environment=true
