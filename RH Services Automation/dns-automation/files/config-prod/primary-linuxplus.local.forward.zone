$TTL 86400
@  IN SOA services.linuxplus.local. admin.linuxplus.local. (
                        2025081301  ; serial (YYYYMMDDnn format recommended)
                        1D          ; refresh
                        1H          ; retry
                        1W          ; expire
                        3H )        ; minimum

; Name Servers
@       IN      NS      services.linuxplus.local.

; DNS Server IP
services        IN      A       10.100.99.99

; Host Records
racdb1          IN      A       10.100.99.10
racdb2          IN      A       10.100.99.20

